# Example environment file for local Docker-based development.
# it is recommended to replace the host names with the IP address of the machine where Docker is running.

# Maat
MAAT_PROTOCOL=http
MAAT_HOST=maathost
MAAT_PORT=8080
MAAT_RESOURCE_PROTOCOL=http
MAAT_RESOURCE_ADDRESS=localhost
MAAT_RESOURCE_PORT=8080
MAAT_SERVICE_PROTOCOL=http
MAAT_SERVICE_ADDRESS=localhost
MAAT_SERVICE_PORT=8080
MAAT_SSL_ENABLED=false

# Mongodb for Maat
MONGODB_HOST=mongo_maat_host
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=abc123
MONGO_TIMEOUT=3000

# Keycloak
KEYCLOAK_ENABLED=false
KEYCLOAK_PROTOCOL=http
KEYCLOAK_HOST=keycloakhost
KEYCLOAK_PORT=8090
KEYCLOAK_USER=admin
KEYCLOAK_PASS=admin
KEYCLOAK_REALM=MaatRealm
KEYCLOAK_ISSUER_URI=http://host.docker.internal:8090/realms/MaatRealm
KEYCLOAK_CLIENT_ID_FOR_USERS=maat-account
KEYCLOAK_CLIENT_ID_FOR_CLIENTS=maat
KEYCLOAK_GRANT_TYPE_FOR_CLIENTS=client_credentials
KEYCLOAK_GRANT_TYPE_FOR_USERS=authorization_code
KEYCLOAK_CLIENT_SECRET=maat-client-secret
MAAT_ROLE_GET_ONLY=get
MAAT_ROLE_POST_ONLY=post
MAAT_ROLE_DELETE_ONLY=delete
MAAT_ROLE_PATCH_ONLY=patch
KEYCLOAK_AUTHORIZATION_L1_ROLES=false
KEYCLOAK_AUTHORIZATION_L2_FILTERS=false
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_ENABLED=false
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_HEADER_NAME=X-Authenticated-User-Id
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_TRUSTED_CLIENT=maat
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_ADMIN_CLIENT_ID=maat
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_ADMIN_CLIENT_SECRET=maat-client-secret
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_CACHE_TTL_SECONDS=300
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_FAIL_ON_KEYCLOAK_ERROR=true
KEYCLOAK_SERVICE_TOKEN_USER_CONTEXT_USER_ACCESS_FILTER_ATTRIBUTES=user_access_filters,get_filter,post_filter,delete_filter,patch_filter

# EventListener for Maat
AUTO_REGISTER=on
EVENT_LISTENER_PROTOCOL=http
EVENT_LISTENER_HOST=elhost
EVENT_LISTENER_PORT=8081

# Web UI for Maat
MAAT_UI_PROTOCOL=http
MAAT_UI_HOST=host.docker.internal
MAAT_UI_PORT=9100

# Mongodb for EventListener
MONGODB_EL_HOST=mongo_el_host
MONGO_EL_USER=admin
MONGO_EL_PASSWORD=abc123
MONGO_EL_PORT=27017
MONGO_EL_TIMEOUT=3000

# Graylog
GRAYLOG_HOST=grayloghost
GRAYLOG_PORT=12201

# Grafana Loki
LOKI_HOST=lokihost

# Logs only in Graylog
# LOGGING_CONFIG=classpath:logback-spring.xml

# Logs in Graylog and file
# LOGGING_CONFIG=classpath:logback-with-file.xml

# Logs in Graylog, file and console
# LOGGING_CONFIG=classpath:logback-with-file-and-console.xml

# Logs only in file and console
LOGGING_CONFIG=classpath:logback-with-file-and-console-without-graylog.xml

# Logs to Grafana Loki in docker-compose
# LOGGING_CONFIG=classpath:logback-loki-docker.xml

# Logs Grafana Loki outside docker-compose
# LOGGING_CONFIG=classpath:logback-loki-appender.xml

# AI Assistant (Streamlit + MCP Server)
API_TYPE=openwebui
SSL_VERIFY=false
OPENAI_BASE_URL=http://llm-server:3000/v1
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini
MCP_URL=http://host.docker.internal:8002/mcp
MAAT_TIMEOUT=60
MAAT_RESOURCE_ENDPOINT=/resourceInventoryManagement/v4.0.0/resource
MAAT_SERVICE_ENDPOINT=/serviceInventoryManagement/v4.0.0/service
MAAT_TLS_VERIFY=false
LOG_LEVEL=INFO
KEYCLOAK_TOKEN_REFRESH_MARGIN=30
KEYCLOAK_REDIRECT_URI=http://host.docker.internal:8501
